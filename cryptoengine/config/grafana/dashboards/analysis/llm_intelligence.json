          "rawSql": "SELECT\n  created_at AS \"시각\",\n  rating AS \"판단\",\n  ROUND((confidence * 100)::numeric, 0) || '%' AS \"신뢰도\",\n  LEFT(reasoning, 200) AS \"분석 요약\",\n  CASE WHEN asset_report IS NOT NULL THEN\n    LEFT(COALESCE((asset_report::json->>'risk_alert'), ''), 150)\n  ELSE '' END AS \"리스크 경보\"\nFROM llm_reports\nORDER BY created_at DESC\nLIMIT 5",
