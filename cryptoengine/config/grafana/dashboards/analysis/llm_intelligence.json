      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cryptoengine-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH matched AS (\n  SELECT lr.created_at, lr.rating, t.side AS executed_side\n  FROM llm_reports lr\n  LEFT JOIN trades t ON t.filled_at BETWEEN lr.created_at AND lr.created_at + INTERVAL '1 hour'\n  WHERE lr.created_at >= NOW() - INTERVAL '30 days'\n)\nSELECT ROUND(\n  (SUM(CASE\n    WHEN (rating IN ('BUY','STRONG_BUY','buy','strong_buy') AND executed_side = 'long')\n      OR (rating IN ('SELL','STRONG_SELL','sell','strong_sell') AND executed_side = 'short')\n    THEN 1 ELSE 0 END\n  )::float / NULLIF(COUNT(executed_side), 0)) * 100, 1\n) AS match_rate_pct FROM matched",
          "refId": "A"
        }
      ],
      "title": "LLM 권장 vs 실행 일치율 (30일)",
      "type": "stat"
    },
