          "refId": "A",
          "format": "time_series",
          "rawSql": "WITH expected AS (SELECT generate_series(date_trunc('hour', NOW() - INTERVAL '24 hours'), date_trunc('hour', NOW()), '1 hour'::interval) AS expected_hour), actual AS (SELECT date_trunc('hour', timestamp) AS hour, COUNT(*) AS cnt FROM ohlcv_data WHERE timeframe = '1h' AND timestamp > NOW() - INTERVAL '24 hours' GROUP BY hour) SELECT e.expected_hour AS time, COALESCE(a.cnt, 0) AS candles_collected FROM expected e LEFT JOIN actual a ON e.expected_hour = a.hour ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C62828",
                "value": null
              },
              {
                "color": "#F9A825",
                "value": 30
              },
              {
                "color": "#2E7D32",
                "value": 60
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        }
      }
    },
