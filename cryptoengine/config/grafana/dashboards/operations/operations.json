  "panels": [
    {
      "id": 1,
      "title": "A. 서비스 헬스 그리드 — market-data",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres",
        "type": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(ROUND(EXTRACT(EPOCH FROM (NOW() - MAX(timestamp)))::numeric, 0), 999) AS sec FROM service_logs WHERE service = 'market-data' AND timestamp > NOW() - INTERVAL '1 hour'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2E7D32",
                "value": null
              },
              {
                "color": "#F9A825",
                "value": 120
              },
              {
                "color": "#C62828",
                "value": 300
              }
            ]
          },
          "decimals": 0,
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "description": "GREEN <2분 / YELLOW 2~5분 / RED >5분"
    },
