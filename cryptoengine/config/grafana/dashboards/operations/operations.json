    {
      "id": 14,
      "title": "C. DB & Redis — 테이블 통계",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "uid": "cryptoengine-postgres",
        "type": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT 'ohlcv_data' AS table_name, COUNT(*) AS rows, MAX(timestamp)::text AS latest FROM ohlcv_data UNION ALL SELECT 'funding_rates', COUNT(*), MAX(collected_at)::text FROM funding_rates UNION ALL SELECT 'market_regimes', COUNT(*), MAX(detected_at)::text FROM market_regimes UNION ALL SELECT 'positions', COUNT(*), MAX(opened_at)::text FROM positions UNION ALL SELECT 'portfolio_snapshots', COUNT(*), MAX(snapshot_at)::text FROM portfolio_snapshots UNION ALL SELECT 'kill_switch_events', COUNT(*), MAX(triggered_at)::text FROM kill_switch_events UNION ALL SELECT 'llm_reports', COUNT(*), MAX(analyzed_at)::text FROM llm_reports ORDER BY table_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": false
          }
        }
      },
      "options": {
        "sortBy": [
          {
            "displayName": "table_name",
            "desc": false
          }
        ]
      }
    },
