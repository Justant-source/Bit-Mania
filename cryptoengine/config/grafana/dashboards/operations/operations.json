    {
      "id": 10,
      "title": "B. 인프라 메트릭 — CPU 사용률",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "uid": "cryptoengine-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "thresholdsStyle": {
              "mode": "area"
            },
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2E7D32",
                "value": null
              },
              {
                "color": "#F9A825",
                "value": 60
              },
              {
                "color": "#C62828",
                "value": 85
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "calcs": ["last"]
        }
      },
      "description": "토큰: <60% safe, 60~85% caution, >85% danger"
    },
    {
      "id": 11,
      "title": "B. 인프라 메트릭 — 메모리 사용률",
