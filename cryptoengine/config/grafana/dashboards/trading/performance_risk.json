    {
      "id": 11,
      "title": "레짐별 PnL 분해",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH trade_with_regime AS (\n  SELECT t.filled_at, t.pnl,\n    (SELECT new_regime FROM regime_transitions\n     WHERE confirmed = TRUE AND confirmed_at <= t.filled_at\n     ORDER BY confirmed_at DESC LIMIT 1) AS new_regime\n  FROM trades t WHERE t.filled_at IS NOT NULL AND $__timeFilter(t.filled_at)\n)\nSELECT new_regime, COUNT(*) AS trade_count, SUM(pnl) AS total_pnl,\n  AVG(pnl) AS avg_pnl,\n  SUM(CASE WHEN pnl > 0 THEN 1 ELSE 0 END)::float / NULLIF(COUNT(*), 0) AS win_rate\nFROM trade_with_regime WHERE new_regime IS NOT NULL GROUP BY new_regime ORDER BY total_pnl DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "regime"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
