    {
      "id": 8,
      "title": "Sortino (30d)",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH daily_snap AS (\n  SELECT DISTINCT ON (snapshot_at::date)\n    snapshot_at::date AS date, total_equity\n  FROM portfolio_snapshots WHERE snapshot_at >= NOW() - INTERVAL '30 days'\n  ORDER BY snapshot_at::date, snapshot_at DESC\n), returns AS (\n  SELECT (total_equity - LAG(total_equity) OVER (ORDER BY date))\n    / NULLIF(LAG(total_equity) OVER (ORDER BY date), 0) AS r\n  FROM daily_snap\n)\nSELECT AVG(r) / NULLIF(STDDEV(CASE WHEN r < 0 THEN r END), 0) * SQRT(365) AS sortino_30d\nFROM returns WHERE r IS NOT NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "color": {
