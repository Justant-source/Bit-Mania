          "format": "table",
          "rawSql": "WITH daily_snap AS (\n  SELECT DISTINCT ON (snapshot_at::date)\n    snapshot_at::date AS date, total_equity\n  FROM portfolio_snapshots\n  WHERE $__timeFilter(snapshot_at)\n  ORDER BY snapshot_at::date, snapshot_at DESC\n), daily_performance AS (\n  SELECT\n    date,\n    total_equity AS total_equity,\n    COALESCE(\n      (total_equity - LAG(total_equity) OVER (ORDER BY date))\n      / NULLIF(LAG(total_equity) OVER (ORDER BY date), 0) * 100, 0\n    ) AS daily_return_pct,\n    COALESCE(total_equity - LAG(total_equity) OVER (ORDER BY date), 0) AS daily_pnl,\n    0.0 AS fees_paid_usd,\n    0 AS trade_count,\n    COALESCE(\n      (total_equity - MAX(total_equity) OVER (ORDER BY date))\n      / NULLIF(MAX(total_equity) OVER (ORDER BY date), 0) * 100, 0\n    ) AS max_drawdown_pct\n  FROM daily_snap\n)\nSELECT date, total_equity, fees_paid_usd, daily_return_pct, trade_count, max_drawdown_pct\nFROM daily_performance ORDER BY date DESC"
