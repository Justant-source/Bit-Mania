    {
      "id": 9,
      "title": "Calmar (30d)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH daily_snap AS (\n  SELECT DISTINCT ON (snapshot_at::date)\n    snapshot_at::date AS date, total_equity\n  FROM portfolio_snapshots WHERE snapshot_at >= NOW() - INTERVAL '30 days'\n  ORDER BY snapshot_at::date, snapshot_at DESC\n), with_peak AS (\n  SELECT date, total_equity, MAX(total_equity) OVER (ORDER BY date) AS peak_eq FROM daily_snap\n), calcs AS (\n  SELECT (total_equity - LAG(total_equity) OVER (ORDER BY date))\n    / NULLIF(LAG(total_equity) OVER (ORDER BY date), 0) AS r,\n    (total_equity - peak_eq) / NULLIF(peak_eq, 0) AS dd\n  FROM with_peak\n)\nSELECT AVG(r) * 365 / NULLIF(ABS(MIN(dd)), 0) AS calmar_30d FROM calcs"
        }
      ],
      "fieldConfig": {
