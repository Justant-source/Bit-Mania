  "schemaVersion": 39,
  "version": 2,
  "id": null,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "time_range",
        "type": "interval",
        "query": "1d,7d,30d,90d,365d",
        "current": {
          "text": "7d",
          "value": "7d"
        },
        "label": "기간"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Kill Switch",
        "datasource": {
          "uid": "cryptoengine-postgres"
        },
        "enable": true,
        "iconColor": "#C62828",
        "rawQuery": "SELECT triggered_at AS time, CONCAT('Kill Switch: ', reason) AS text FROM kill_switch_events WHERE $__timeFilter(triggered_at)"
      },
      {
        "name": "Regime Change",
        "datasource": {
          "uid": "cryptoengine-postgres"
        },
        "enable": true,
        "iconColor": "#9E9E9E",
        "rawQuery": "SELECT detected_at AS time, CONCAT(from_regime, ' to ', to_regime) AS text FROM regime_transitions WHERE $__timeFilter(detected_at)"
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/ce-overview",
      "icon": "doc"
    },
    {
      "title": "Strategies & Positions",
      "url": "/d/ce-strategies-positions"
    },
    {
      "title": "Operations",
      "url": "/d/ce-operations"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "자산 곡선",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "USD",
          "format": "time_series",
          "rawSql": "SELECT snapshot_at AS time, total_equity AS equity FROM portfolio_snapshots WHERE $__timeFilter(snapshot_at) ORDER BY snapshot_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "showPoints": "never",
            "lineWidth": 2
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#1976D2"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "showLegend": true
        }
      },
      "description": "USD 자산 곡선. 어노테이션: Kill Switch(적색 수직선) + 레짐 전환(회색 수직선) 자동 오버레이"
    },
    {
      "id": 2,
      "title": "일일 PnL",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "WITH daily_snap AS (\n  SELECT DISTINCT ON (snapshot_at::date)\n    snapshot_at::date AS date, total_equity\n  FROM portfolio_snapshots\n  WHERE $__timeFilter(snapshot_at)\n  ORDER BY snapshot_at::date, snapshot_at DESC\n), daily_performance AS (\n  SELECT\n    date,\n    total_equity AS total_equity,\n    COALESCE(\n      (total_equity - LAG(total_equity) OVER (ORDER BY date))\n      / NULLIF(LAG(total_equity) OVER (ORDER BY date), 0) * 100, 0\n    ) AS daily_return_pct,\n    COALESCE(total_equity - LAG(total_equity) OVER (ORDER BY date), 0) AS daily_pnl,\n    0.0 AS fees_paid_usd,\n    0 AS trade_count,\n    COALESCE(\n      (total_equity - MAX(total_equity) OVER (ORDER BY date))\n      / NULLIF(MAX(total_equity) OVER (ORDER BY date), 0) * 100, 0\n    ) AS max_drawdown_pct\n  FROM daily_snap\n)\nSELECT date AS time, daily_pnl FROM daily_performance ORDER BY date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C62828",
                "value": null
              },
              {
                "color": "#2E7D32",
                "value": 0
              }
            ]
          }
        }
      },
      "options": {
        "xTickLabelRotation": -45
      }
    },
    {
      "id": 3,
      "title": "누적 펀딩 수익",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "WITH daily AS (\n  SELECT\n    date_trunc('day', snapshot_at) AS day,\n    AVG(total_equity) AS avg_equity\n  FROM portfolio_snapshots\n  WHERE $__timeFilter(snapshot_at)\n  GROUP BY 1\n),\ndaily_pnl AS (\n  SELECT day,\n    avg_equity - LAG(avg_equity) OVER (ORDER BY day) AS daily_change\n  FROM daily\n)\nSELECT\n  day AS time,\n  COALESCE(SUM(daily_change) OVER (ORDER BY day), 0) AS cumulative_funding\nFROM daily_pnl\nORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 20
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#FB8C00"
          }
        }
      }
    },
    {
      "id": 4,
      "title": "수수료 vs 펀딩수익",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "WITH daily_snap AS (\n  SELECT DISTINCT ON (snapshot_at::date)\n    snapshot_at::date AS date, total_equity\n  FROM portfolio_snapshots WHERE $__timeFilter(snapshot_at)\n  ORDER BY snapshot_at::date, snapshot_at DESC\n)\nSELECT date::timestamp AS time,\n  0.0 AS fees_paid,\n  GREATEST(COALESCE(total_equity - LAG(total_equity) OVER (ORDER BY date), 0), 0) AS funding_received,\n  COALESCE(total_equity - LAG(total_equity) OVER (ORDER BY date), 0) AS net\nFROM daily_snap ORDER BY date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
