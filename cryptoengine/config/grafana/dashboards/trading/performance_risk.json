                  "mode": "fixed",
                  "fixedColor": "#C62828"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "funding_received"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2E7D32"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "net"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1976D2"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "stacking": "none",
        "barWidth": 0.6
      },
      "description": "일별 순자산 변화 (funding_payments 데이터 수집 전까지 portfolio_snapshots 기반 추정)"
    },
    {
      "id": 5,
      "title": "드로우다운",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "WITH equity AS (SELECT snapshot_at AS time, total_equity AS eq FROM portfolio_snapshots WHERE $__timeFilter(snapshot_at)),\npeak AS (SELECT time, MAX(eq) OVER (ORDER BY time) AS peak_eq, eq FROM equity)\nSELECT time, ((eq - peak_eq) / NULLIF(peak_eq, 0)) * 100 AS drawdown_pct FROM peak ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
