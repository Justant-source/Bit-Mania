{
  "title": "Overview",
  "uid": "ce-overview",
  "tags": [
    "cryptoengine",
    "overview",
    "p0"
  ],
  "timezone": "Asia/Seoul",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 2,
  "description": "CryptoEngine 트레이딩 시스템 종합 대시보드. Hero KPI + Risk Status + 자산 곡선 + 전략 분석",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "time_range",
        "type": "interval",
        "query": "1h,6h,24h,7d,30d",
        "current": {
          "text": "24h",
          "value": "24h"
        },
        "label": "시간범위",
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Kill Switch",
        "datasource": {
          "uid": "cryptoengine-postgres"
        },
        "enable": true,
        "iconColor": "#C62828",
        "rawQuery": "SELECT triggered_at AS time, CONCAT('Kill Switch: ', reason) AS text, level AS tags FROM kill_switch_events WHERE $__timeFilter(triggered_at)"
      },
      {
        "name": "Regime Change",
        "datasource": {
          "uid": "cryptoengine-postgres"
        },
        "enable": true,
        "iconColor": "#757575",
        "rawQuery": "SELECT detected_at AS time, CONCAT(from_regime, ' to ', to_regime) AS text, to_regime AS tags FROM regime_transitions WHERE $__timeFilter(detected_at)"
      }
    ]
  },
  "links": [
    {
      "title": "Performance & Risk",
      "url": "/d/ce-performance-risk",
      "icon": "doc"
    },
    {
      "title": "Strategies & Positions",
      "url": "/d/ce-strategies-positions",
      "icon": "doc"
    },
    {
      "title": "Operations",
      "url": "/d/ce-operations",
      "icon": "cog"
    },
    {
      "title": "LLM Intelligence",
      "url": "/d/ce-llm-intelligence",
      "icon": "doc"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "총 자산 (USD)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT total_equity AS total_equity, snapshot_at FROM portfolio_snapshots ORDER BY snapshot_at DESC LIMIT 1), yesterday AS (SELECT total_equity AS total_equity FROM portfolio_snapshots WHERE snapshot_at <= NOW() - INTERVAL '24 hours' ORDER BY snapshot_at DESC LIMIT 1) SELECT l.total_equity AS current_equity, l.total_equity - y.total_equity AS delta_24h_usd, ((l.total_equity - y.total_equity) / NULLIF(y.total_equity, 0)) * 100 AS delta_24h_pct FROM latest l, yesterday y"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#757575",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "delta_24h_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#C62828",
                      "value": null
                    },
                    {
                      "color": "#757575",
                      "value": -0.1
                    },
                    {
                      "color": "#2E7D32",
                      "value": 0.1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^current_equity$/"
        }
      },
      "description": "총 자산 USD. 어제 대비 변동 표시. 토큰: pnl.positive/neutral/negative"
    },
    {
      "id": 2,
      "title": "일일 PnL",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(realized_pnl_today, 0) AS daily_pnl_usd, COALESCE(daily_drawdown * 100, 0) AS daily_return_pct FROM portfolio_snapshots ORDER BY snapshot_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C62828",
                "value": null
              },
              {
                "color": "#757575",
                "value": -0.01
              },
              {
                "color": "#2E7D32",
                "value": 0.01
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^daily_pnl_usd$/"
        }
      },
      "description": "오늘 PnL (USD). 색상: 음수=red, 0±=neutral, 양수=green. 토큰: pnl.*"
    },
    {
      "id": 3,
      "title": "월 누적 PnL (MTD)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH month_start AS (SELECT total_equity AS start_equity FROM portfolio_snapshots WHERE snapshot_at >= date_trunc('month', CURRENT_DATE) ORDER BY snapshot_at ASC LIMIT 1), current_val AS (SELECT total_equity AS current_equity FROM portfolio_snapshots ORDER BY snapshot_at DESC LIMIT 1) SELECT c.current_equity - m.start_equity AS mtd_pnl_usd, ((c.current_equity - m.start_equity) / NULLIF(m.start_equity, 0)) * 100 AS mtd_pnl_pct FROM month_start m, current_val c"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C62828",
                "value": null
              },
              {
                "color": "#757575",
                "value": -0.01
              },
              {
                "color": "#2E7D32",
                "value": 0.01
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^mtd_pnl_usd$/"
        }
      },
      "description": "이번달 누적 PnL (USD). 토큰: pnl.*"
    },
    {
      "id": 4,
      "title": "미실현 PnL",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  COALESCE(SUM(current_pnl), 0) AS total_unrealized_pnl,\n  COUNT(*) FILTER (WHERE position_count > 0) AS open_position_count\nFROM strategy_states"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "open_position_count"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "오픈 포지션"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "description": "미실현 손익 (USD) + 오픈 포지션 개수"
    },
    {
      "id": 5,
      "title": "Kill Switch 상태",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT CASE WHEN EXISTS (SELECT 1 FROM kill_switch_events WHERE resolved_at IS NULL) THEN 'ACTIVE' ELSE 'NORMAL' END AS ks_status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#757575",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "NORMAL": {
                  "text": "✓ NORMAL",
                  "color": "#2E7D32",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "ACTIVE": {
                  "text": "ACTIVE",
                  "color": "#B71C1C",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NORMAL",
                  "color": "#2E7D32"
                }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Kill Switch 활성 여부. ACTIVE 시 배경 진적색으로 강조"
    },
    {
      "id": 6,
      "title": "청산까지 거리",
      "type": "bargauge",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  'N/A' AS symbol,\n  NULL::numeric AS liq_distance_pct\nFROM strategy_states\nWHERE FALSE"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 50,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#B71C1C",
                "value": null
              },
              {
                "color": "#C62828",
                "value": 5
              },
              {
                "color": "#F9A825",
                "value": 10
              },
              {
                "color": "#2E7D32",
                "value": 20
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/liq_distance_pct/"
        }
      },
      "description": "현재가 → 청산가 거리(%). 토큰: risk.critical<5%, risk.danger 5~10%, risk.caution 10~20%, risk.safe≥20%"
    },
    {
      "id": 7,
      "title": "마진 사용률",
      "type": "gauge",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  ROUND(\n    (COALESCE(SUM(allocated_capital), 0)\n     / NULLIF((SELECT total_equity FROM portfolio_snapshots ORDER BY snapshot_at DESC LIMIT 1), 0) * 100\n    )::numeric, 1\n  ) AS margin_ratio_pct\nFROM strategy_states"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2E7D32",
                "value": null
              },
              {
                "color": "#F9A825",
                "value": 0.5
              },
              {
                "color": "#C62828",
                "value": 0.7
              },
              {
                "color": "#B71C1C",
                "value": 0.85
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "description": "포지션 마진 합산 / 총자산. 토큰: <0.5 safe, 0.5~0.7 caution, 0.7~0.85 danger, ≥0.85 critical"
    },
    {
      "id": 8,
      "title": "일일 손실 한도까지 ($-10)",
      "type": "bargauge",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH today_pnl AS (SELECT (SELECT total_equity FROM portfolio_snapshots WHERE snapshot_at::date = CURRENT_DATE ORDER BY snapshot_at ASC LIMIT 1) AS day_start, (SELECT total_equity FROM portfolio_snapshots ORDER BY snapshot_at DESC LIMIT 1) AS current_eq) SELECT current_eq - day_start AS today_pnl_usd, CASE WHEN current_eq - day_start < 0 THEN ABS(current_eq - day_start) / 10.0 * 100 ELSE 0 END AS loss_limit_progress_pct FROM today_pnl"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2E7D32",
                "value": null
              },
              {
                "color": "#F9A825",
                "value": 50
              },
              {
                "color": "#C62828",
                "value": 70
              },
              {
                "color": "#B71C1C",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/loss_limit_progress_pct/"
        }
      },
      "description": "[Phase 5 모드] 일일 손실 한도 $-10 진행률. Phase 4에서는 상대값(-5%)이 적용되어 본 패널 무의미. 토큰: <50% safe, 50~70% caution, 70~90% danger, ≥90% critical"
    },
    {
      "id": 9,
      "title": "자산 곡선 (30일)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT snapshot_at AS time, total_equity AS equity FROM portfolio_snapshots WHERE snapshot_at >= NOW() - INTERVAL '30 days' ORDER BY snapshot_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#1976D2"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "showLegend": false
        }
      },
      "description": "어노테이션 자동 오버레이: dashboard 레벨에서 KillSwitch + 레짐 전환 표시"
    },
    {
      "id": 10,
      "title": "전략별 누적 PnL",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n  snapshot_at AS time,\n  strategy_id AS metric,\n  ROUND((current_pnl)::numeric, 2) AS cumulative_pnl\nFROM portfolio_snapshots ps,\n  jsonb_array_elements(strategies) AS elem\nCROSS JOIN LATERAL (\n  SELECT elem->>'strategy_id' AS strategy_id,\n         (elem->>'current_pnl')::numeric AS current_pnl\n) strat\nWHERE $__timeFilter(snapshot_at)\n  AND strategy_id IS NOT NULL\nORDER BY snapshot_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "funding-arb"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FB8C00"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "현재 자본 배분",
      "type": "piechart",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT 'Cash (USDT)' AS category,\n  GREATEST(\n    (SELECT total_equity FROM portfolio_snapshots ORDER BY snapshot_at DESC LIMIT 1)\n    - COALESCE((SELECT SUM(allocated_capital) FROM strategy_states), 0),\n    0\n  ) AS value\nUNION ALL\nSELECT strategy_id, COALESCE(allocated_capital, 0)\nFROM strategy_states\nWHERE allocated_capital > 0\nORDER BY category"
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "id": 12,
      "title": "시스템 상태",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "uid": "cryptoengine-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT service, EXTRACT(EPOCH FROM (NOW() - MAX(timestamp))) AS sec FROM service_logs WHERE timestamp > NOW() - INTERVAL '1 hour' GROUP BY service ORDER BY service"
        },
        {
          "refId": "B",
          "format": "table",
          "rawSql": "SELECT new_regime FROM regime_transitions WHERE confirmed = TRUE ORDER BY confirmed_at DESC LIMIT 1"
        },
        {
          "refId": "C",
          "format": "table",
          "rawSql": "SELECT rate * 100 AS funding_rate_pct FROM funding_rates WHERE symbol='BTCUSDT' ORDER BY collected_at DESC LIMIT 1"
        },
        {
          "refId": "D",
          "format": "table",
          "rawSql": "SELECT rating FROM llm_reports ORDER BY created_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "#2E7D32",
                "value": null
              },
              {
                "color": "#F9A825",
                "value": 120
              },
              {
                "color": "#C62828",
                "value": 300
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "links": [
        {
          "title": "Operations",
          "url": "/d/ce-operations"
        }
      ],
      "description": "서비스별 마지막 이벤트 경과 시간(초). 클릭 시 Operations 대시보드로 이동"
    }
  ]
}