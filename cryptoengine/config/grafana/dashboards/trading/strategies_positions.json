      },
      "targets": [
        {
          "refId": "regime",
          "format": "time_series",
          "rawSql": "SELECT detected_at AS time, CASE regime WHEN 'RANGING' THEN 1 WHEN 'TRENDING_UP' THEN 2 WHEN 'TRENDING_DOWN' THEN -2 WHEN 'VOLATILE' THEN 3 END AS regime_value FROM market_regimes WHERE detected_at >= $__timeFrom AND detected_at <= $__timeTo ORDER BY detected_at"
        },
        {
          "refId": "pnl",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', filled_at) AS time, SUM(SUM(pnl)) OVER (ORDER BY date_trunc('hour', filled_at)) AS cumulative_pnl FROM trades WHERE filled_at IS NOT NULL AND filled_at >= $__timeFrom AND filled_at <= $__timeTo GROUP BY 1 ORDER BY 1"
        }
