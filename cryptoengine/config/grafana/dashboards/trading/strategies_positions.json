    {
      "id": 9,
      "title": "FA 진입 조건 (5개)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "uid": "cryptoengine-postgres",
        "type": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT * FROM (\n  SELECT 1 AS sort_order,\n    '① 펀딩비율 ≥ 임계값' AS \"진입 조건\",\n    ROUND((rate * 100)::numeric, 4) || '% / 8h' AS \"현재값\",\n    '0.0120% / 8h (연 25%)' AS \"임계값\",\n    CASE WHEN rate >= 0.00012 THEN '✅ 충족'\n      ELSE '❌ 미충족 (연 ' || ROUND((rate * 3 * 365 * 100)::numeric, 1) || '% < 25%)'\n    END AS \"상태\"\n  FROM (SELECT rate FROM funding_rates WHERE symbol = 'BTCUSDT' ORDER BY collected_at DESC LIMIT 1) latest\n\n  UNION ALL\n\n  SELECT 2, '② 연속 4틱 초과',\n    (SELECT SUM(CASE WHEN rate >= 0.00012 THEN 1 ELSE 0 END) FROM (SELECT rate FROM funding_rates WHERE symbol='BTCUSDT' ORDER BY collected_at DESC LIMIT 4) r)::text || ' / 4',\n    '4 연속', '❌ 미충족 (실시간 카운터는 전략 내부)'\n\n  UNION ALL\n\n  SELECT 3, '③ BEP 순수익성 (2사이클)',\n    ROUND((rate * 150 * 5 * 2)::numeric, 4) || ' - ' || ROUND((150 * 0.00130 * 2)::numeric, 4) || ' USDT',\n    '> 0 USDT',\n    CASE WHEN (rate * 150 * 5 * 2 - 150 * 0.00130 * 2) > 0 THEN '✅ 충족'\n      ELSE '❌ 미충족 (수수료 > 펀딩수익)' END\n  FROM (SELECT rate FROM funding_rates WHERE symbol = 'BTCUSDT' ORDER BY collected_at DESC LIMIT 1) latest\n\n  UNION ALL\n\n  SELECT 4, '④ 빈 포지션 슬롯',\n    (SELECT COUNT(*) FROM positions WHERE closed_at IS NULL AND strategy_id='funding_arb')::text || ' / 1',\n    '< 1',\n    CASE WHEN (SELECT COUNT(*) FROM positions WHERE closed_at IS NULL AND strategy_id='funding_arb') < 1\n      THEN '✅ 충족 (빈 슬롯)' ELSE '❌ 미충족' END\n\n  UNION ALL\n\n  SELECT 5, '⑤ Kill Switch 비활성',\n    CASE WHEN EXISTS (SELECT 1 FROM kill_switch_events WHERE resolved_at IS NULL) THEN '활성 (차단)' ELSE '비활성 (정상)' END,\n    '비활성',\n    CASE WHEN NOT EXISTS (SELECT 1 FROM kill_switch_events WHERE resolved_at IS NULL)\n      THEN '✅ 충족' ELSE '❌ 미충족' END\n) sub ORDER BY sort_order"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sort_order"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "상태"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*✅.*",
                      "result": {
                        "color": "#2E7D32",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*❌.*",
                      "result": {
                        "color": "#C62828",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "진입 조건"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "options": {
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "description": "5개 FA 진입 조건 실시간 체크 (funding_rate_history 기반)"
    },
    {
      "id": 10,
      "title": "오픈 포지션",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "uid": "cryptoengine-postgres",
        "type": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  symbol, side, size, entry_price, current_price, unrealized_pnl,\n  CASE WHEN unrealized_pnl IS NOT NULL AND size > 0 AND entry_price > 0 AND leverage > 0 THEN\n    ROUND((unrealized_pnl / (size * entry_price / leverage) * 100)::numeric, 2)\n  ELSE NULL END AS unrealized_pnl_pct,\n  leverage,\n  ROUND((size * entry_price / NULLIF(leverage, 0))::numeric, 2) AS margin_used,\n  CASE WHEN leverage > 0 THEN\n    CASE WHEN side = 'long' THEN ROUND((entry_price * (1 - 0.9/leverage))::numeric, 2)\n         WHEN side = 'short' THEN ROUND((entry_price * (1 + 0.9/leverage))::numeric, 2)\n    END\n  ELSE NULL END AS est_liq_price,\n  CASE\n    WHEN side = 'long' AND current_price > 0 AND leverage > 0 THEN\n      ROUND(((current_price - entry_price * (1 - 0.9/leverage)) / current_price * 100)::numeric, 2)\n    WHEN side = 'short' AND current_price > 0 AND leverage > 0 THEN\n      ROUND(((entry_price * (1 + 0.9/leverage) - current_price) / current_price * 100)::numeric, 2)\n  END AS liq_distance_pct,\n  ROUND(EXTRACT(EPOCH FROM (NOW() - opened_at)) / 3600, 1) AS holding_hours\nFROM positions\nWHERE closed_at IS NULL\nORDER BY liq_distance_pct ASC NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
