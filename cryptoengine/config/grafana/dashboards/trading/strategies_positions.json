    {
      "id": 10,
      "title": "오픈 포지션",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "uid": "cryptoengine-postgres",
        "type": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  symbol,\n  side,\n  size,\n  entry_price,\n  current_price,\n  unrealized_pnl,\n  CASE WHEN unrealized_pnl IS NOT NULL THEN\n    (unrealized_pnl / NULLIF(size * entry_price / leverage, 0)) * 100\n  ELSE NULL END AS unrealized_pnl_pct,\n  leverage,\n  margin_used,\n  liquidation_price,\n  CASE\n    WHEN side = 'long' THEN\n      ((current_price - liquidation_price) / NULLIF(current_price, 0)) * 100\n    WHEN side = 'short' THEN\n      ((liquidation_price - current_price) / NULLIF(current_price, 0)) * 100\n  END AS liq_distance_pct,\n  EXTRACT(EPOCH FROM (NOW() - opened_at)) / 3600 AS holding_hours\nFROM positions\nWHERE closed_at IS NULL\nORDER BY liq_distance_pct ASC NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
