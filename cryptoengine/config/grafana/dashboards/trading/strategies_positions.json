      "datasource": {
        "uid": "cryptoengine-postgres",
        "type": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (strategy_id) strategy_id AS metric, allocated_capital AS value FROM strategy_states ORDER BY strategy_id, updated_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "text": {}
      }
    },
    {
      "id": 2,
      "title": "전략 KPI",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "cryptoengine-postgres",
        "type": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH strategy_pnl AS (\n  SELECT\n    strategy_id,\n    COALESCE(SUM(pnl), 0) AS total_pnl,\n    COUNT(*) AS trade_count\n  FROM trades\n  WHERE filled_at IS NOT NULL\n  GROUP BY strategy_id\n),\nstrategy_state AS (\n  SELECT DISTINCT ON (strategy_id)\n    strategy_id, allocated_capital, current_pnl\n  FROM strategy_states\n  ORDER BY strategy_id, updated_at DESC\n)\nSELECT\n  s.strategy_id,\n  COALESCE(s.allocated_capital, 0) AS allocated_capital,\n  COALESCE(s.current_pnl, 0) AS unrealized_pnl,\n  COALESCE(p.total_pnl, 0) AS realized_pnl_total,\n  COALESCE(p.trade_count, 0) AS trade_count\nFROM strategy_state s\nLEFT JOIN strategy_pnl p ON s.strategy_id = p.strategy_id\nORDER BY s.strategy_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "unrealized_pnl"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#C62828",
                      "value": null
                    },
                    {
                      "color": "#2E7D32",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "realized_pnl_total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#C62828",
                      "value": null
                    },
                    {
                      "color": "#2E7D32",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "allocated_capital"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
      "options": {
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      }
