# ============================================================
# CryptoEngine (single-process bot) — environment
# Copy to .env and fill in. .env is never committed.
# docker compose reads it for substitution AND passes it to the bot (env_file).
# Do not `source .env` in a shell that later runs docker compose: exported shell
# variables override the .env file.
# ============================================================

# ── Exchange: Bybit (mainnet only) ───────────────────────────
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
# Must be exactly "false". The bot refuses to start otherwise.
BYBIT_TESTNET=false

# ── Database ─────────────────────────────────────────────────
# Used by postgres, bot and pg-backup. Compose sets DB_HOST=postgres for the bot.
DB_PASSWORD=change_me_to_a_strong_password
# Optional overrides (defaults: postgres / 5432 / cryptoengine / cryptoengine).
# On the host (replay, tests) use DB_HOST=127.0.0.1.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=cryptoengine
# DB_USER=cryptoengine

# ── Telegram (required: alerts and commands, and the host watchdog) ─────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Dashboard ────────────────────────────────────────────────
# Without DASHBOARD_TOKEN the dashboard is disabled (only /healthz would exist).
# Generate: openssl rand -hex 24
DASHBOARD_TOKEN=change_me_long_random_token
# Base URL behind the Telegram "dashboard" buttons, without the token
# (the bot appends ?t=<DASHBOARD_TOKEN> itself): http://<host>:3000/
DASHBOARD_URL=
# Host port mapped to the container's 3000.
DASHBOARD_PORT=3000

# ── Safety / runtime ─────────────────────────────────────────
# Leverage limit checked before every order; values above 3.0 are clamped to 3.0.
SAFETY_LEVERAGE_LIMIT=3.0
LOG_LEVEL=INFO
# 1 = do everything except send orders (smoke test against the real exchange). Leave unset in production.
# BOT_DRY_RUN=1
# Kill-switch thresholds and max_capital_usd (path inside the container).
# BOT_CONFIG=config/bot.yaml

# ── Backup container ─────────────────────────────────────────
# BACKUP_CRON=0 17 * * *        # 02:00 KST
# BACKUP_ON_STARTUP=false
